<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FAFAFA"
    android:orientation="vertical">

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fitsSystemWindows="true"
        android:theme="@style/ThemeOverlay.Material3.Dark.ActionBar">
        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbarCarDetail"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="?attr/colorPrimary"
            app:navigationIcon="@drawable/ic_arrow_back"
            app:navigationIconTint="@android:color/white"
            app:title="Detail Mobil"
            app:titleTextColor="@android:color/white" />
    </com.google.android.material.appbar.AppBarLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:paddingBottom="24dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="280dp"
                android:background="#EEE">

                <androidx.viewpager2.widget.ViewPager2
                    android:id="@+id/vpDetailImages"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent" />

                <TextView
                    android:id="@+id/tvCarPriceBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="top|end"
                    android:layout_margin="16dp"
                    android:background="@drawable/price_badge_bg"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="6dp"
                    android:text="Rp -"
                    android:textColor="@android:color/white"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:elevation="4dp"/>

                <TextView
                    android:id="@+id/tvImageCount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom|end"
                    android:layout_margin="12dp"
                    android:background="#80000000"
                    android:textColor="#FFF"
                    android:padding="6dp"
                    android:text="1/1"
                    android:textSize="12sp"
                    android:textStyle="bold"/>
            </FrameLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:id="@+id/tvCarNameDetail"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Nama Mobil"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    android:textColor="@color/black"/>

                <TextView
                    android:id="@+id/tvCarBrandDetail"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Merek Mobil"
                    android:textColor="#666"
                    android:textSize="16sp" />

                <TextView
                    android:id="@+id/tvCarYearDetail"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Tahun: -" />
                <TextView
                    android:id="@+id/tvCarLocationDetail"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Lokasi: -" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginVertical="12dp"
                    android:background="#DDD" />

                <TextView android:id="@+id/tvVariantDetail" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Varian: -" />
                <TextView android:id="@+id/tvBodyDetail" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Tipe: -" />
                <TextView android:id="@+id/tvColorDetail" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Warna: -" />
                <TextView android:id="@+id/tvTransmissionDetail" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Transmisi: -" />
                <TextView android:id="@+id/tvFuelDetail" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Bahan Bakar: -" />
                <TextView android:id="@+id/tvKmRangeDetail" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Jarak Tempuh: -" />
                <TextView android:id="@+id/tvCapacityDetail" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Kapasitas Mesin: -" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginVertical="12dp"
                    android:background="#DDD" />

                <TextView android:id="@+id/tvSellerDetail" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Penjual: -" android:textStyle="bold"/>
                <TextView android:id="@+id/tvContactDetail" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Kontak: -"/>

                <Button
                    android:id="@+id/btnContactSeller"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="Hubungi Penjual" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal"
                    android:weightSum="2">
                    <Button
                        android:id="@+id/btnWhatsapp"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="4dp"
                        android:layout_weight="1"
                        android:backgroundTint="#25D366"
                        android:text="Beli via WA"
                        android:textColor="@android:color/white" />
                    <Button
                        android:id="@+id/btnShare"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="4dp"
                        android:layout_weight="1"
                        android:backgroundTint="#FF4081"
                        android:text="Share" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginVertical="16dp"
                    android:background="#CCC" />

                <TextView android:id="@+id/tvAvgRating" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Rating: -"/>
                <RatingBar android:id="@+id/ratingBarInput" android:layout_width="wrap_content" android:layout_height="wrap_content" android:numStars="5"/>
                <EditText android:id="@+id/etCommentInput" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="Tulis komentar..."/>
                <Button android:id="@+id/btnSubmitComment" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Kirim"/>

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvComments"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"/>

            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>