<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="6dp"
    app:cardCornerRadius="12dp"
    app:cardElevation="4dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="120dp">

            <ImageView
                android:id="@+id/imgCar"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:src="@drawable/ic_car"
                android:contentDescription="Car image" />

            <ImageView
                android:id="@+id/btnFavorite"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_gravity="top|end"
                android:layout_margin="8dp"
                android:src="@drawable/ic_wishlist_border"
                android:background="@drawable/circle_bg"
                android:padding="6dp"
                app:tint="@color/accent_pink"
                android:contentDescription="Favorite button" />

            <TextView
                android:id="@+id/tvSoldLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="top|start"
                android:layout_margin="8dp"
                android:background="@drawable/bg_sold_label"
                android:paddingHorizontal="8dp"
                android:paddingVertical="4dp"
                android:text="SOLD"
                android:textColor="@android:color/white"
                android:textStyle="bold"
                android:textSize="10sp"
                android:visibility="gone" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="10dp">

            <TextView
                android:id="@+id/tvCarName"
                android:fontFamily="@font/lato_regular"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Civic Turbo"
                android:textStyle="bold"
                android:textSize="15sp"
                android:maxLines="1"
                android:ellipsize="end"/>

            <TextView
                android:id="@+id/tvCarBrand"
                android:fontFamily="@font/lato_regular"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Honda"
                android:textColor="#666"
                android:textSize="12sp"/>

            <TextView
                android:id="@+id/tvCarPrice"
                android:fontFamily="@font/lato_regular"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Rp 420.000.000"
                android:textColor="@color/red"
                android:textStyle="bold"
                android:textSize="14sp"
                android:layout_marginTop="4dp"/>

            <TextView
                android:id="@+id/btnMarkSold"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Mark as SOLD"
                android:gravity="center"
                android:textColor="@android:color/white"
                android:backgroundTint="@color/red"
                android:paddingVertical="6dp"
                android:textStyle="bold"
                android:textSize="12sp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_sold_label"
                android:visibility="gone"/>

            <CheckBox
                android:id="@+id/cbCompare"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Bandingkan"
                android:textSize="12sp"
                android:minHeight="0dp"
                android:minWidth="0dp"
                android:padding="0dp"
                android:visibility="gone"/>
        </LinearLayout>
    </LinearLayout>
</androidx.cardview.widget.CardView>